<Window x:Class="ClipShot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" MinWidth="400">
  <Grid.Resources>
   <ResourceDictionary><ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="ClipWindowBrush" Color="#FAFBFC"/>
     <SolidColorBrush x:Key="ClipHeaderBrush" Color="#F3F4F6"/>
     <SolidColorBrush x:Key="ClipSearchBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="ClipSeparatorBrush" Color="#E0E3E8"/>
     <SolidColorBrush x:Key="ClipSelectionBrush" Color="#E8EBEF"/>
     <SolidColorBrush x:Key="ClipSecondaryBrush" Color="#69717D"/>
     <SolidColorBrush x:Key="ClipIndicatorBrush" Color="#414852"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="ClipWindowBrush" Color="#242529"/>
     <SolidColorBrush x:Key="ClipHeaderBrush" Color="#202125"/>
     <SolidColorBrush x:Key="ClipSearchBrush" Color="#2E3035"/>
     <SolidColorBrush x:Key="ClipSeparatorBrush" Color="#3A3C42"/>
     <SolidColorBrush x:Key="ClipSelectionBrush" Color="#373A41"/>
     <SolidColorBrush x:Key="ClipSecondaryBrush" Color="#A9AFBA"/>
     <SolidColorBrush x:Key="ClipIndicatorBrush" Color="#D8DCE3"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="HeaderSurface" Background="{ThemeResource ClipHeaderBrush}" BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="44"/><ColumnDefinition x:Name="CaptionSpace" Width="104"/></Grid.ColumnDefinitions>
    <Grid x:Name="TitleDragRegion" Background="Transparent" Padding="20,0,0,0">
     <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <Image x:Name="TitleGlyph" Source="ms-appx:///Assets/ClipShot.png" Width="28" Height="28" Stretch="Uniform"/>
      <TextBlock x:Name="TitleText" Text="ClipShot" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
    <Button x:Name="HelpButton" Grid.Column="1" Click="HelpClick" AutomationProperties.Name="Справка" ToolTipService.ToolTip="Справка" Width="32" Height="36" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4"><FontIcon Glyph="&#xE897;" FontSize="18"/></Button>
    <Button x:Name="SettingsButton" Grid.Column="2" Click="SettingsClick" AutomationProperties.Name="Настройки" ToolTipService.ToolTip="Настройки" Width="36" Height="36" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4"><FontIcon Glyph="&#xE713;" FontSize="19"/></Button>
   </Grid>
  </Border>
  <Border Grid.Row="1" Padding="14" BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="0,0,0,1">
   <Grid>
    <TextBox x:Name="Search" PlaceholderText="Поиск по истории" AutomationProperties.Name="Поиск по истории и шаблонам" TextChanged="SearchChanged" Height="42" FontSize="15" Padding="40,8,12,8" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource ClipSeparatorBrush}" Background="{ThemeResource ClipSearchBrush}"/>
    <FontIcon Glyph="&#xE721;" FontSize="17" Foreground="{ThemeResource ClipSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
   </Grid>
  </Border>
  <ScrollViewer x:Name="HistoryScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Groups" Spacing="0"/></ScrollViewer>
  <Border x:Name="FooterSurface" Grid.Row="3" Padding="16,12,12,12" Background="{ThemeResource ClipHeaderBrush}" BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="0,1,0,0">
   <StackPanel Spacing="9">
    <TextBlock x:Name="Status" Text="" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="14">
     <StackPanel Orientation="Horizontal" Spacing="6"><Border BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="↑↓" FontSize="12"/></Border><TextBlock x:Name="SelectHint" Text="Выбрать" FontSize="11" Foreground="{ThemeResource ClipSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="6"><Border BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="Enter" FontSize="12"/></Border><TextBlock x:Name="CopyHint" Text="Копировать" FontSize="11" Foreground="{ThemeResource ClipSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="6"><Border BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="Esc" FontSize="12"/></Border><TextBlock x:Name="CloseHint" Text="Закрыть" FontSize="11" Foreground="{ThemeResource ClipSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</Window>
