<Window x:Class="ClipShot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" MinWidth="220" MinHeight="80">
  <Grid.Resources>
   <ResourceDictionary><ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="ClipWindowBrush" Color="#FAFBFC"/>
     <SolidColorBrush x:Key="ClipHeaderBrush" Color="#F3F4F6"/>
     <SolidColorBrush x:Key="ClipSearchBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="ClipSeparatorBrush" Color="#E0E3E8"/>
     <SolidColorBrush x:Key="ClipSelectionBrush" Color="#E8EBEF"/>
     <SolidColorBrush x:Key="ClipSecondaryBrush" Color="#69717D"/>
     <SolidColorBrush x:Key="ClipIndicatorBrush" Color="#414852"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="ClipWindowBrush" Color="#242529"/>
     <SolidColorBrush x:Key="ClipHeaderBrush" Color="#202125"/>
     <SolidColorBrush x:Key="ClipSearchBrush" Color="#2E3035"/>
     <SolidColorBrush x:Key="ClipSeparatorBrush" Color="#3A3C42"/>
     <SolidColorBrush x:Key="ClipSelectionBrush" Color="#373A41"/>
     <SolidColorBrush x:Key="ClipSecondaryBrush" Color="#A9AFBA"/>
     <SolidColorBrush x:Key="ClipIndicatorBrush" Color="#D8DCE3"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="HeaderSurface" Visibility="Collapsed" Background="{ThemeResource ClipHeaderBrush}" BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="44"/><ColumnDefinition x:Name="CaptionSpace" Width="104"/></Grid.ColumnDefinitions>
    <Grid x:Name="TitleDragRegion" Background="Transparent" Padding="12,0,0,0">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image x:Name="TitleGlyph" Visibility="Collapsed" Source="ms-appx:///Assets/ClipShot.png" Width="28" Height="28" Stretch="Uniform"/>
      <TextBlock x:Name="TitleText" Text="ClipShot" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource ClipSecondaryBrush}"/>
     </StackPanel>
    </Grid>
    <Button x:Name="HelpButton" Grid.Column="1" Click="HelpClick" AutomationProperties.Name="Справка" ToolTipService.ToolTip="Справка" Width="32" Height="36" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4"><FontIcon Glyph="&#xE897;" FontSize="18"/></Button>
    <Button x:Name="SettingsButton" Grid.Column="2" Click="SettingsClick" AutomationProperties.Name="Настройки" ToolTipService.ToolTip="Настройки" Width="36" Height="36" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4"><FontIcon Glyph="&#xE713;" FontSize="19"/></Button>
   </Grid>
  </Border>
  <StackPanel x:Name="TemplateGroups" Grid.Row="2"/>
  <Border Grid.Row="3" Padding="6,3,24,3" BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="0,1,0,0">
   <Grid>
    <TextBox x:Name="Search" AutomationProperties.Name="Поиск по истории и шаблонам" TextChanged="SearchChanged" Height="32" FontSize="13" Padding="32,4,10,4" CornerRadius="4" BorderThickness="0" Background="Transparent"/>
    <FontIcon x:Name="SearchGlyph" Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource ClipSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" ToolTipService.ToolTip="Переместить окно"/>
   </Grid>
  </Border>
  <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Groups" Spacing="0"/></ScrollViewer>
  <HyperlinkButton x:Name="ManualUpdateLink" Grid.Row="4" HorizontalAlignment="Right" FontSize="10" Padding="8,0" Height="24" Opacity="0.6" Content="Проверить обновление" Click="ManualUpdateClick"/>
  <Border x:Name="FooterSurface" Grid.Row="5" Visibility="Collapsed" Padding="16,8,12,8" Background="{ThemeResource ClipHeaderBrush}" BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="0,1,0,0">
   <StackPanel Spacing="9">
    <Border x:Name="UpdateNotice" Visibility="Collapsed" Background="{ThemeResource ClipSearchBrush}" Padding="8" CornerRadius="4">
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
      <Button x:Name="UpdateInstall" Grid.Column="1" Content="Обновить сейчас" Click="InstallUpdateClick" FontSize="12" Padding="8,4"/>
      <Button Grid.Column="2" Content="×" Click="DismissUpdate" ToolTipService.ToolTip="Позже" Padding="6,4"/>
     </Grid>
    </Border>
    <TextBlock x:Name="Status" Text="" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"/>
    <StackPanel x:Name="FooterHints" Visibility="Collapsed" Orientation="Horizontal" Spacing="14">
     <StackPanel Orientation="Horizontal" Spacing="6"><Border BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="↑↓" FontSize="12"/></Border><TextBlock x:Name="SelectHint" Text="Выбрать" FontSize="11" Foreground="{ThemeResource ClipSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="6"><Border BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="Enter" FontSize="12"/></Border><TextBlock x:Name="CopyHint" Text="Копировать" FontSize="11" Foreground="{ThemeResource ClipSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="6"><Border BorderBrush="{ThemeResource ClipSeparatorBrush}" BorderThickness="1" CornerRadius="3" Padding="5,2"><TextBlock Text="Esc" FontSize="12"/></Border><TextBlock x:Name="CloseHint" Text="Закрыть" FontSize="11" Foreground="{ThemeResource ClipSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
    </StackPanel>
   </StackPanel>
  </Border>
  <Button Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Padding="0" Margin="0,0,1,1" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource ClipSecondaryBrush}" PointerPressed="ResizeGripPressed" ToolTipService.ToolTip="Изменить размер" AutomationProperties.Name="Изменить размер"><TextBlock Text="◢" FontSize="11"/></Button>
 </Grid>
</Window>
